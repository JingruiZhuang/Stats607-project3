__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store

results/raw/*.csv
results/raw/*.pkl
# final figures are committed so the repo is readable without rerunning

data/simulated/*
!**/.gitkeep

# course material and the source paper (not ours to redistribute)
*.pdf

# make figures sentinel
results/figures/.stamp

# profiler artefacts
results/profiles/*.prof
results/profiles/*.txt
!results/profiles/.gitkeep
# baseline + benchmark data products.  The Unit 2 estimates are the exception:
# they are the reference every regression test compares against, so they are
# committed rather than regenerated, and `make baseline-reference` rebuilds
# them from the frozen code in baseline/.
results/baseline/*.csv
!results/baseline/estimates.csv
results/benchmarks/*.csv
results/profiles/*_profile_estimates.csv
results/benchmarks/*_complexity_estimates.csv
